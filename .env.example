# Frontend (Vite) — copy to .env
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon key>

# Optional: set to "off" to always call Binance/CoinGecko directly from the browser
# (default: use the cached `market-data` Edge Function when the user is signed in)
# VITE_MARKET_PROXY=off

# Edge Function secrets (NOT in this file — set them with the CLI):
#   supabase secrets set CRON_SECRET=<long random string>
#   supabase secrets set COINGECKO_API_KEY=<optional demo key>
